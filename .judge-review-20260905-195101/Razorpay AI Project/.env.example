# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (Defaults to SQLite for instant local zero-dependency run)
DATABASE_URL=sqlite+aiosqlite:///./recovery_autopilot.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+asyncpg://autopilot:autopilot@localhost:5432/recovery_autopilot

# Redis / Background Worker
REDIS_URL=redis://localhost:6379/0
USE_IN_PROCESS_WORKER=true

# Model Provider: 'gemini', 'openai', 'ollama', or 'fake'
MODEL_PROVIDER=fake

# Gemini Settings (Default: Gemini 3.7 Flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# OpenAI Settings (e.g. gpt-4o, gpt-4o-mini, gpt-4-turbo)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama Settings (Default: Qwen3 8B)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Execution Mode: 'synthetic' (zero network, default), 'razorpay_test' (authentic test API calls), 'production' (locked)
PAYMENT_EXECUTION_MODE=synthetic
KILL_SWITCH_ACTIVE=false
ALLOW_PRODUCTION_MODE=false
CONFIRM_LIVE_FINANCIAL_TRANSACTIONS=false

# Razorpay Test Credentials (Never use live rzp_live_ keys; strictly requires rzp_test_ prefix)
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=sample_test_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_sample_secret

# Operational Safety & Guardrail Configuration
SYNTHETIC_MODE=true
SIMULATE_NOTIFICATIONS=true
HUMAN_REVIEW_THRESHOLD_INR=15000.0
MIN_CONFIDENCE_THRESHOLD=0.70
MAX_CONTACT_ATTEMPTS=3
MIN_HOURS_BETWEEN_CONTACTS=24

# Frontend CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
