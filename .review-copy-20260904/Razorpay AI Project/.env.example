# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (Defaults to SQLite for instant local zero-dependency run)
DATABASE_URL=sqlite+aiosqlite:///./recovery_autopilot.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql+asyncpg://autopilot:autopilot@localhost:5432/recovery_autopilot

# Redis / Background Worker
REDIS_URL=redis://localhost:6379/0
USE_IN_PROCESS_WORKER=true

# Model Provider: 'gemini', 'ollama', or 'fake'
MODEL_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Razorpay Test Credentials (Never commit live credentials)
RAZORPAY_KEY_ID=rzp_test_simulation_key
RAZORPAY_KEY_SECRET=rzp_test_simulation_secret
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_simulation_key

# Operational Safety & Guardrail Configuration
SYNTHETIC_MODE=true
SIMULATE_NOTIFICATIONS=true
HUMAN_REVIEW_THRESHOLD_INR=15000.0
MIN_CONFIDENCE_THRESHOLD=0.70
MAX_CONTACT_ATTEMPTS=3
MIN_HOURS_BETWEEN_CONTACTS=24

# Frontend CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
